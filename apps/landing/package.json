{
  "name": "landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .ssr --emptyOutDir && node scripts/prerender.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "shots": "node scripts/shots.mjs",
    "previews": "node scripts/capture-previews.mjs",
    "og": "node scripts/og-image.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@alex_mtz/bittobyte-ui": "workspace:*",
    "@fontsource-variable/antonio": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/bowlby-one": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "lucide-react": "^0.300.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@bittobyte/eslint-config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.57.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.4"
  }
}
