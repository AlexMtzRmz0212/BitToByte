{
  "name": "@alex_mtz/bittobyte-ui",
  "version": "0.2.0",
  "description": "Shared UI component library for the BitToByte ecosystem",
  "type": "module",
  "main": "./dist/bittobyte-ui.cjs.js",
  "module": "./dist/bittobyte-ui.es.js",
  "exports": {
    ".": {
      "import": "./dist/bittobyte-ui.es.js",
      "require": "./dist/bittobyte-ui.cjs.js"
    },
    "./styles": "./dist/bittobyte-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "lucide-react": ">=0.300.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "playground": "vite"
  },
  "devDependencies": {
    "@bittobyte/eslint-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "lucide-react": "^0.300.0",
    "postcss": "^8.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
